{
  "name": "@yootun/dsh-client-report",
  "description": "yootun 工作台 AI 报表业务页（纯 client）：列表/详情双态、详情轮询、重新生成幂等、HTML 导出与组合趋势图；请求函数、错误文案与作品卡指标布局由插件注入，样式随消费插件进 bundle",
  "version": "0.2.2-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@yootun/dsh-client-ui-kit": "workspace:*",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
