{
  "name": "@yootun/dsh-client-ui-kit",
  "description": "yootun 插件 UI 复合组件库：工作台壳、洞察卡、图表族、筛选条、状态族、回执与助手 Dock，全部映射官方 token 与集中 --yt-* 语义变量",
  "version": "0.2.2-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
