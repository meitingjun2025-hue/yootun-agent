{
  "name": "@yootun/dsh-bundle-yootun",
  "description": "yootun 产品 bundle：自有品牌/企业层插件与配置覆盖的 patch 层，插进 desktop profile",
  "version": "0.2.2-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "dependencies": {
    "@yootun/dsh-client-ui-access": "workspace:*",
    "@yootun/dsh-client-ui-brand": "workspace:*"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
