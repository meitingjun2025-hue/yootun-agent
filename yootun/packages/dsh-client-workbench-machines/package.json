{
  "name": "@yootun/dsh-client-workbench-machines",
  "description": "yootun 工作台数据流 machine 共享核心（纯 client）：登录、单账号采集、批量采集、作品查询的状态与竞态守卫；插件以 ports 适配层接入各自 schema 投影",
  "version": "0.2.2-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "node --test tests/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
