{
  "name": "@yootun/dsh-workbench-host-kit",
  "description": "yootun 工作台 Host 共享库：同源路由信任判定与 action 分发、任务登记表、profile 锁、状态文件原子写与按 root 写队列、系统 Chrome 探测与浏览器生命周期；三工作台与 managed-mcp / media-upload 的 Host 侧唯一实现",
  "version": "0.2.2-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tests/types/tsconfig.json && tsdown",
    "test": "node --test tests/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
