{
  "name": "@yootun/dsh-douyin-workbench",
  "description": "yootun 抖音工作台：Host 半（`/api/desktop/yootun/douyin-workbench` 同源路由 + 系统 Chrome 状态 + 本地 storage_state/profile 管理 + 经 Workbench MCP 的 55 项白名单调用，action 按批次演进）+ client 半（root main 中央面板与 sidebar.panellist 入口，7 Tab：账号总览/账号作品/发布排期看板/爆款素材看板占位/爆款拆解占位/爆款基因库占位/AI 报表）",
  "version": "0.2.2-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node tests/client/verify-bundle-stylesheets.mjs && node ../../scripts/verify-plugin-runtime-bundle.mjs",
    "test": "node --test tests/host.test.ts && node --test tests/state.test.ts && node --test tests/route.test.ts && node --test tests/dispose.test.ts && node --test tests/d2.test.ts && node --test tests/d3.test.ts && node --test tests/d4d5.test.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@yootun/dsh-workbench-mcp": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@yootun/dsh-client-ui-kit": "workspace:*",
    "@yootun/dsh-workbench-mcp": "workspace:*",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
