{
  "name": "@yootun/dsh-media-upload",
  "description": "yootun 媒体上传能力（纯 Host 插件）：/_dsh/uploader/* 同源路由与 media_upload 会话工具，经 Workbench 面授权后预签名直传，不持有 TOS 凭证",
  "version": "0.2.2-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "node --test tests/media-upload.test.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@yootun/dsh-workbench-mcp": "workspace:*",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
